# Print FarmOS — ./install.sh (or .\install.ps1) writes a real .env for you.
# Only copy this file if you are configuring by hand.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Database (used by Docker Compose)
POSTGRES_PASSWORD=farmos
DATABASE_URL=postgresql+asyncpg://farmos:farmos@db:5432/farmos
REDIS_URL=redis://redis:6379/0

# Public browser origin for CORS / QR links
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulated printers run faster than real time so the dashboard is usable in development.
SIMULATED_TIME_SCALE=20

# WooCommerce (optional). Leave blank until you connect the shop.
WOOCOMMERCE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# Shopify (optional). Use instead of WooCommerce, or alongside it.
# Shop can be "your-store" or "your-store.myshopify.com".
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2024-10

# Public URL used in phone notification buttons (the address you open FarmOS from a phone)
PUBLIC_APP_URL=http://localhost:3000

# Phone notifications — ntfy (recommended). Install the ntfy app and subscribe to the topic.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Optional additional providers (leave blank if unused)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional notification webhook (Slack-compatible JSON POST, or any HTTP endpoint)
NOTIFY_WEBHOOK_URL=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=farmos@localhost
SMTP_TO=

# Optional SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=

UPLOAD_DIR=/data
RUN_SCHEDULER=false
