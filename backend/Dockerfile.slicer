FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    wget \
    ca-certificates \
    file \
    libfuse2 \
    libgtk-3-0 \
    libwebkit2gtk-4.1-0 \
    libegl1 \
    libgl1 \
    libgomp1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libx11-6 \
    libxext6 \
    dbus \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Official PrusaSlicer AppImage, extracted so the worker does not need FUSE at runtime.
ARG PRUSASLICER_URL=https://github.com/prusa3d/PrusaSlicer/releases/download/version_2.9.2/PrusaSlicer-2.9.2+linux-x64-GTK3-202503141156.AppImage
RUN mkdir -p /opt/prusaslicer \
    && wget -q -O /tmp/PrusaSlicer.AppImage "$PRUSASLICER_URL" \
    && chmod +x /tmp/PrusaSlicer.AppImage \
    && cd /tmp && ./PrusaSlicer.AppImage --appimage-extract \
    && mv /tmp/squashfs-root /opt/prusaslicer/app \
    && ln -sf /opt/prusaslicer/app/usr/bin/prusa-slicer /usr/local/bin/prusa-slicer \
    && rm -f /tmp/PrusaSlicer.AppImage \
    && prusa-slicer --help >/dev/null 2>&1 || true

COPY . .
ENV PYTHONUNBUFFERED=1
ENV SLICER_BIN=/usr/local/bin/prusa-slicer
CMD ["python", "-m", "app.slicer_worker"]
